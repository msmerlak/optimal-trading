\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces The optimal policy across kernels. (a)~For the temporary-plus-resilient kernel ($\eta =0.5$, $\gamma =1$, $\kappa =2$), the two moving-average rates $b_1,b_2$ against risk aversion $\lambda $: the slow rate tends to zero as $\lambda \to 0$, where the position becomes non-stationary, and both grow with $\lambda $. (b)~Position impulse responses by kernel ($\theta =1$, normalized at $\tau =0.3$): the exponential and two-average kernels cut off exponentially, the power-law kernel keeps an algebraic tail (Section~\ref {sec:powerlaw}), and the Markowitz limit is a spike at zero lag. (c)~The power-law policy across $\beta $, a scale-free kernel of slope $(\beta -1)/2$.}}{8}{figure.1}\protected@file@percent }
\newlabel{fig:structure}{{1}{8}{The optimal policy across kernels. (a)~For the temporary-plus-resilient kernel ($\eta =0.5$, $\gamma =1$, $\kappa =2$), the two moving-average rates $b_1,b_2$ against risk aversion $\lambda $: the slow rate tends to zero as $\lambda \to 0$, where the position becomes non-stationary, and both grow with $\lambda $. (b)~Position impulse responses by kernel ($\theta =1$, normalized at $\tau =0.3$): the exponential and two-average kernels cut off exponentially, the power-law kernel keeps an algebraic tail (Section~\ref {sec:powerlaw}), and the Markowitz limit is a spike at zero lag. (c)~The power-law policy across $\beta $, a scale-free kernel of slope $(\beta -1)/2$}{figure.1}{}}
\newlabel{eq:rate-policy}{{17}{8}{Power-law kernels and fractional calculus}{equation.17}{}}
\newlabel{eq:fractional}{{18}{8}{Power-law kernels and fractional calculus}{equation.18}{}}
\newlabel{eq:fracpos}{{19}{8}{Power-law kernels and fractional calculus}{equation.19}{}}
\citation{ObizhaevaWang2013}
\citation{GatheralSchiedSlynko2012}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces The trading filter for exponential versus power-law transient impact ($\gamma =1$, $\kappa =2$, $\beta =0.5$; small $\lambda =0.1$, $\eta =0.05$). (a)~Transfer function $|H(\omega )|=1/\sqrt  {\hat  n(\omega )}$: both share the low-frequency Markowitz plateau and roll off as $\omega ^{-1}$ under the temporary cost at high frequency; between them the exponential settles on a finite-memory plateau while the power law slides as $\omega ^{-(1+\beta )/2}$. (b)~Impulse response $h(\tau )=\mathcal  F^{-1}[\hat  n_+^{-1}]$: the exponential filter cuts off past the temporary-cost scale, the power law leaves an algebraic tail.}}{9}{figure.2}\protected@file@percent }
\newlabel{fig:transfer}{{2}{9}{The trading filter for exponential versus power-law transient impact ($\gamma =1$, $\kappa =2$, $\beta =0.5$; small $\lambda =0.1$, $\eta =0.05$). (a)~Transfer function $|H(\omega )|=1/\sqrt {\hat n(\omega )}$: both share the low-frequency Markowitz plateau and roll off as $\omega ^{-1}$ under the temporary cost at high frequency; between them the exponential settles on a finite-memory plateau while the power law slides as $\omega ^{-(1+\beta )/2}$. (b)~Impulse response $h(\tau )=\mathcal F^{-1}[\hat n_+^{-1}]$: the exponential filter cuts off past the temporary-cost scale, the power law leaves an algebraic tail}{figure.2}{}}
