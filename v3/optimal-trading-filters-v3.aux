\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Anatomy of the trading filter, exponential versus power-law transient impact ($\gamma =1$, $\kappa =2$, $\beta =0.5$; small $\lambda =0.1$, $\eta =0.05$). (a)~Transfer function $|H(\omega )|=1/\sqrt  {\hat  n(\omega )}$: both share the low-frequency Markowitz plateau $1/\sqrt  \lambda $ (edge $\omega _c$) and roll off as $\omega ^{-1}$ under the temporary cost at high frequency (edges $\omega _e$ for the exponential, $\omega _*$ for the power law); between them the finite-memory exponential settles on the plateau $1/\sqrt  {2\kappa \gamma }$ while the long-memory power law slides as $\omega ^{-(1+\beta )/2}$. (b)~Impulse response $h(\tau )=\mathcal  {F}^{-1}[\hat  n_+^{-1}]$: the temporary cost caps the short lag at $1/\sqrt  \eta $; past it the exponential filter cuts off (short memory) and the power law leaves an algebraic tail (long memory).}}{12}{figure.2}\protected@file@percent }
\newlabel{fig:transfer}{{2}{12}{Anatomy of the trading filter, exponential versus power-law transient impact ($\gamma =1$, $\kappa =2$, $\beta =0.5$; small $\lambda =0.1$, $\eta =0.05$). (a)~Transfer function $|H(\omega )|=1/\sqrt {\hat n(\omega )}$: both share the low-frequency Markowitz plateau $1/\sqrt \lambda $ (edge $\omega _c$) and roll off as $\omega ^{-1}$ under the temporary cost at high frequency (edges $\omega _e$ for the exponential, $\omega _*$ for the power law); between them the finite-memory exponential settles on the plateau $1/\sqrt {2\kappa \gamma }$ while the long-memory power law slides as $\omega ^{-(1+\beta )/2}$. (b)~Impulse response $h(\tau )=\mathcal {F}^{-1}[\hat n_+^{-1}]$: the temporary cost caps the short lag at $1/\sqrt \eta $; past it the exponential filter cuts off (short memory) and the power law leaves an algebraic tail (long memory)}{figure.2}{}}
\newlabel{eq:threshold}{{23}{12}{Rate response and the surfing threshold}{equation.23}{}}
\citation{GohbergKrein1970,Arveson1975}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Impact surfing (exponential kernel, $\gamma =1$, $\kappa =2$). (a)~The rate response $R(\theta )$: the exponential kernel (solid) reverses sign at $\theta ^\ast $ as inventory risk $\lambda $ grows, while the power-law kernel (dashed) stays positive at every risk aversion. (b)~Phase diagram: the optimum follows the signal ($R>0$) below the boundary $\theta ^\ast (\lambda )$ and trades against it ($R<0$) above; the boundary meets the axes at $\theta =\kappa $ and $\lambda =2\kappa \gamma /3$.}}{13}{figure.3}\protected@file@percent }
\newlabel{fig:surf}{{3}{13}{Impact surfing (exponential kernel, $\gamma =1$, $\kappa =2$). (a)~The rate response $R(\theta )$: the exponential kernel (solid) reverses sign at $\theta ^\ast $ as inventory risk $\lambda $ grows, while the power-law kernel (dashed) stays positive at every risk aversion. (b)~Phase diagram: the optimum follows the signal ($R>0$) below the boundary $\theta ^\ast (\lambda )$ and trades against it ($R<0$) above; the boundary meets the axes at $\theta =\kappa $ and $\lambda =2\kappa \gamma /3$}{figure.3}{}}
